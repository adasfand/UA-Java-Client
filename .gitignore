# IDE 本机设置
.idea/
*.iml
.vscode/
.classpath
.project
.settings/

# 构建产物与工具缓存
target/
out/
.cache/
*.class

# 共享已审核的本机模拟配置；该目录内其他个人文件默认忽略
config/local/*
!config/local/client.properties
!config/local/nodes.properties
!config/local/write-test.properties
!config/local/write-test-nodes.properties

# 凭据与 PKI
pki/
*.p12
*.pfx
*.jks
*.keystore
*.key
*.pem
