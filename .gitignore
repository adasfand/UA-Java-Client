*.cer
# 本机演示服务器的公开证书快照，不含私钥
!config/local/server.der
.env
.env.*
!.env.example
*.local.properties

# 运行日志、诊断转储和编辑器临时文件
logs/
hs_err_pid*
replay_pid*
*.hprof
*.jfr
*.log
*.tmp
*.bak
*.catalog.lock
*.swp
*.swo
*~

